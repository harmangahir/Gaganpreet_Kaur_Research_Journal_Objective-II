@article{KUMAR2025100038,
title = {Recent progresses on high entropy alloy development using machine learning: A review},
journal = {Computational Materials Today},
volume = {8},
pages = {100038},
year = {2025},
issn = {2950-4635},
doi = {https://doi.org/10.1016/j.commt.2025.100038},
url = {https://www.sciencedirect.com/science/article/pii/S2950463525000146},
author = {Abhishek Kumar and Nilay Krishna Mukhopadhyay and Thakur Prasad Yadav},
keywords = {High Entropy Intermetallic, Multicomponent, Machine learning},
abstract = {High-entropy alloy (HEA)-based materials have attracted considerable attention owing to their exciting opportunities for fundamental research and practical applications over the past 20 years. Through alloys/materials designs, the properties of the materials can be several orders of magnitude higher than that of conventional alloys. High entropy alloys represent a special class of complex concentrated alloys with unique properties and demanding applications. This review presents a comprehensive overview of the progress in developing high-entropy materials using machine learning and examines fabrication techniques and design of HEAs based on deep learning of recent research publications. It also outlines potential for further research directions in this field and provides an understanding of the current progress of HEAs regarding the application of Machine learning (ML) unlocking the next level of alloy development. It starts with describing the general characteristics of HEAs, such as their multicomponent nature, the multiphase constitution, mechanical properties, and stability in corrosive and high-temperature environments. It has been shown how multiple data analysis methods like supervised machine learning, unsupervised clustering, deep machine learning, reinforcement machine learning, etc. can be used to predict many of the important material properties like phase stability, mechanical strength, hydrogen storage capacity, etc., as opposed to the conventional practices which are often time-consuming and less accurate based on trial-and-error approaches. Moreover, the applications of ML to computational approaches such as calculation of phase diagrams (CALPHAD), first-principle, and molecular dynamics have been addressed as a means to fortify models of HEAs. Critical challenges, like data limitations, challenges in model explainability, and computational complexity of applying machine learning to HEAs development are reviewed. This review also emphasizes the role of ML in creating a data-driven framework, optimizing HEAs properties, and moving forward with the trend of machine learning-driven materials discovery. The subsequent case studies demonstrate how, by using ML, new HEAs have been discovered, supporting the usefulness of it in materials science. A prospective outlook on future directions that will shape ML for future advances in HEAs, including data sharing, better algorithms, and stronger physics-informed constraints will be emphasized.}
}
@article{YAN2026103846,
title = {Multiscale fuzzy wavelet-attention framework enhanced by support vector regression for intelligent financial risk and bankruptcy forecasting},
journal = {Ain Shams Engineering Journal},
volume = {17},
number = {1},
pages = {103846},
year = {2026},
issn = {2090-4479},
doi = {https://doi.org/10.1016/j.asej.2025.103846},
url = {https://www.sciencedirect.com/science/article/pii/S2090447925005878},
author = {Han Yan and Zheng Gao and Mohammad khishe},
keywords = {Bankruptcy forecasting, Multiscale fuzzy, Wavelet-attention framework, Support vector regression},
abstract = {Accurate forecasting of financial distress, particularly corporate bankruptcy, remains a critical challenge due to the inherent non-linearity, volatility, and uncertainty in financial time series data. Existing approaches often struggle with overfitting, a lack of interpretability, sensitivity to noise, and limited capacity to model multi-scale temporal dependencies. Furthermore, conventional machine learning models fail to capture short-term and long-term trend fluctuations while providing limited mechanisms for uncertainty quantification. This paper proposes a novel framework for intelligent financial risk forecasting: a multiscale fuzzy wavelet-attention framework with residual learning via support vector regression (MFWSVR). The proposed model integrates discrete wavelet transforms for multiscale decomposition, multi-level attention mechanisms to prioritize critical temporal patterns, and adaptive fuzzy information granules to capture uncertainty and regime shifts in financial markets. A residual learning scheme is introduced using SVR to enhance predictive precision, allowing the model to refine predictions and reduce bias in high-variance financial environments iteratively. The model under consideration has been tested on the Polish, Taiwanese, and Chinese bankruptcy prediction datasets alongside several SOTA models, such as TGNN, DeepSurv, XGBoost, and RFR. From our findings, it is evident that MFWSVR exceeds the given benchmarks in all evaluated metrics, achieving significant gains over competing models. In particular, MFWSVR obtained an MAE of 0.09 (Polish dataset), 0.11 (Taiwanese dataset), and 0.13 (Chinese dataset) at 1-year prediction horizon with R2 values of 0.91, 0.87, and 0.83 respectively. At a 3-year horizon, the model still performs strongly with an MAE of 0.13, 0.15, and 0.17 across the three datasets, alongside high R2 values of 0.83, 0.81, and 0.78. In contrast, baseline models TGNN and DeepSurv experience performance loss at the 3-year mark, with MAE values of 0.16 and 0.17. MFWSVR owes its ability to quantify prediction uncertainty to the integration of interval prediction through wavelet decomposition and fuzzy granulation, which is particularly valuable in financial risk management where prediction accuracy greatly influences strategic decisions.}
}
@article{SINGH2025127243,
title = {Mapping stock market dynamics: A tripartite neural network approach using modified grid search for stock market prediction},
journal = {Expert Systems with Applications},
volume = {278},
pages = {127243},
year = {2025},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2025.127243},
url = {https://www.sciencedirect.com/science/article/pii/S0957417425008656},
author = {Sachin Singh and Mohinder Singh and Shradha Attri},
keywords = {Stock market prediction, Artificial neural network, Deep neural network, Long short-term memory, Deep learning, Machine learning},
abstract = {The challenge of stock market prediction still persists for investors, researchers, portfolio managers, and a diverse array of stakeholders. This study aims to investigate the effectiveness of artificial neural networks, deep neural networks, and long-term memory models in predicting stock market indices. The study encompasses daily index prices of Nifty 50, S&P 500, and Euronext 100, along with macroeconomic data and technical indicators from January 2015 to September 2023, containing 2201 observations for each market. When evaluated using different metrics, the results indicate better performance of artificial neural network models than deep neural networks and long short-term memory models in most cases. The results from the validation set, test set, and an extra holdout set indicate better performance of artificial neural networks in the context of the Nifty 50 index. In the case of the S&P 500, the deep neural network performed well on validation set results, and artificial neural networks performed better than other models in the test set and holdout set predictions. In the case of Euronext 100, the deep neural network again performed better on the validation set; however, the Long short-term memory model outperformed other models with better predictions on testing and holdout set data. The study also applies a modified grid search approach to find the optimal hyperparameters, where the hyperparameters from the simpler model, i.e., artificial neural network using a conventional grid search approach, were used in more complex models like deep neural network and long short-term memory model.}
}
@article{DENG2024108842,
title = {Multi-sentiment fusion for stock price crash risk prediction using an interpretable ensemble learning method},
journal = {Engineering Applications of Artificial Intelligence},
volume = {135},
pages = {108842},
year = {2024},
issn = {0952-1976},
doi = {https://doi.org/10.1016/j.engappai.2024.108842},
url = {https://www.sciencedirect.com/science/article/pii/S0952197624010005},
author = {Shangkun Deng and Qunfang Luo and Yingke Zhu and Hong Ning and Yiting Yu and Yizhuo Gao and Quan Shen and Tatsuro Shimada},
keywords = {Stock price crash, Investor sentiment, Ensemble learning, Hyperparameter optimization, Model interpretation},
abstract = {With the development of the Chinese security market, stock price crashes have occurred frequently, and extant studies have proved that investor sentiment is one of the most significant factors that have led to dramatic volatility of stock prices. Additionally, irrational sentiment poses formidable challenges to traditional methods of predicting stock price crashes. Based on an ensemble learning approach, this research endeavors to explore the effects of investor sentiment indicators on stock price crashes within the Chinese stock market. First of all, several advanced machine learning techniques are employed for stock price crash predictions. Meanwhile, the hyperparameter optimization method is applied to improve the performance of the prediction model. In addition, the interpretable machine learning method is applied to analyze the important investor sentiment indicators that significantly influence stock price crashes. Experiment results show that the method proposed in this research performs better than the benchmark methods, especially for the small-cap samples. Additionally, foreign investor sentiment indicators contribute more to prediction results than individual and institutional sentiments. The proposed method can provide market regulators and investors with an innovative perspective on stock price crash prediction with multiple sentiment fusion.}
}
@article{WANG2024123671,
title = {A combination prediction model based on Theil coefficient and induced continuous aggregation operator for the prediction of Shanghai composite index},
journal = {Expert Systems with Applications},
volume = {249},
pages = {123671},
year = {2024},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2024.123671},
url = {https://www.sciencedirect.com/science/article/pii/S0957417424005372},
author = {Yixiang Wang and Zhicheng Hu and Kai Zhang and Jiayi Zhou and Ligang Zhou},
keywords = {Interval data, Combination prediction, Continuous aggregation operator, Induced aggregation operator, Theil coefficient, Effectiveness theory},
abstract = {This paper proposes an interval combination prediction model for Shanghai composite index, utilizing the Theil coefficient and the induced continuous generalized ordered weighted logarithmic harmonic averaging (ICGOWLHA) operator. The effectiveness of the proposed model under specific weight conditions and the existence of its analytical solution are demonstrated. Shanghai composite index's case analysis demonstrates that, in terms of interval root mean squared error (IRMSE), interval mean absolute error (IMAE), interval mean absolute percentage error (IMAPE), and interval mean squared percentage error (IMSPE), the proposed model's predictive performance improvements over the best-performing single prediction model are 29.33%, 25.72%, 26.10%, and 28.86%, respectively. At the same time, the theoretical properties of the model are verified in the results of the case analysis, and the model's convergence is reflected in sensitivity analysis. Through extensive model comparisons, it is observed that the model proposed in this paper exhibits strong generalization, without specific limitations on data size or feature count. It demonstrates good aggregation prediction performance for interval data. Moreover, it is applicable to various fields, including finance, environment, and others.}
}
@article{MOSTAFAVI2025100631,
title = {Key technical indicators for stock market prediction},
journal = {Machine Learning with Applications},
volume = {20},
pages = {100631},
year = {2025},
issn = {2666-8270},
doi = {https://doi.org/10.1016/j.mlwa.2025.100631},
url = {https://www.sciencedirect.com/science/article/pii/S2666827025000143},
author = {Seyed Mostafa Mostafavi and Ali Reza Hooman},
keywords = {Technical indicator, Stock market, S&P 500 index, Machine learning, LSTM, XGBoost, Random forest, SVR, PCA},
abstract = {The use of technical indicators for forecasting the stock market is widespread among investors and researchers. It is crucial to determine the optimal number of input technical indicators to predict the stock market successfully. However, there is no consensus on which collection of technical indicators is most suitable. The selection of technical indicators for a given forecasting model continues to be an active area of research. To our knowledge, there is limited published work on the importance of technical indicators in various categories such as momentum, trend, volatility, and volume. To identify the key technical indicators for stock market prediction, we employed XGBoost, Random Forest, Support Vector Regression, and LSTM regression techniques using 88 technical indicators as input data. We also used the PCA method for dimension reduction. The results reveal the most significant technical indicators within the momentum, trend, volatility, and volume categories. Our findings provide evidence that the proposed model is highly effective in predicting daily prices (with and without lag in Close price) on the S&P 500 stock index.}
}
@article{2025iii,
title = {Contents},
journal = {Procedia Computer Science},
volume = {258},
