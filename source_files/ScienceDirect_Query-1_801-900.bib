@article{ZHANG2025377,
title = {Forecasting realized volatility with spillover effects: Perspectives from graph neural networks},
journal = {International Journal of Forecasting},
volume = {41},
number = {1},
pages = {377-397},
year = {2025},
issn = {0169-2070},
doi = {https://doi.org/10.1016/j.ijforecast.2024.09.002},
url = {https://www.sciencedirect.com/science/article/pii/S0169207024000967},
author = {Chao Zhang and Xingyue Pu and Mihai Cucuringu and Xiaowen Dong},
keywords = {Graph neural network, Realized volatility, Spillover effect, Quasi-likelihood, Nonlinearity},
abstract = {We present a novel nonparametric methodology for modeling and forecasting multivariate realized volatilities using customized graph neural networks to incorporate spillover effects across stocks. The proposed model offers the benefits of incorporating spillover effects from multi-hop neighbors, capturing nonlinear relationships, and flexible training with different loss functions. The empirical findings suggest that incorporating spillover effects from multi-hop neighbors alone does not yield a clear advantage in terms of predictive accuracy. Furthermore, modeling nonlinear spillover effects enhances the forecasting accuracy of realized volatilities, particularly for short-term horizons of up to one week. More importantly, our results consistently indicate that training with the quasi-likelihood loss leads to substantial improvements in model performance compared to the commonly used mean squared error, primarily due to its superior handling of heteroskedasticity. A comprehensive series of empirical evaluations in alternative settings confirm the robustness of our results.}
}
@article{NAKATA2026133274,
title = {Detecting structural changes in the stock market and explaining them through cluster structure embeddings},
journal = {Expert Systems with Applications},
volume = {331},
pages = {133274},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2026.133274},
url = {https://www.sciencedirect.com/science/article/pii/S0957417426021834},
author = {Yoshiyuki Nakata and Kaira Sekiguchi and Yukio Ohsawa},
keywords = {Entropy, Stock market, Change point detection, Structural change, Embedding vector, RAG},
abstract = {The stock market is a complex system influenced by diverse factors, such as monetary policy, economic cycles, geopolitical risks, and innovation. These dynamics significantly affect investment performance. Detecting such structural changes early and understanding the underlying factors is crucial for effective investment decision-making. This paper proposes an explainable intelligent decision support framework for the detection and interpretation of stock market structural changes. The proposed method monitors the dynamics of correlation-based cluster structures computed from high-frequency return data and detects market-structure changes using an entropy-based indicator. To interpret detected changes, we introduce a structure-aware representation, termed Cluster Structure Embedding (CSE), which maps mathematically grounded market structure signals into a language-compatible space. This representation enables the retrieval of relevant financial news associated with detected structural shifts, thereby providing interpretable explanations for market regime changes. Applying the proposed method to S&P 500 and S&P Mid-Cap 400 constituents demonstrates its ability to detect structural changes not captured by conventional market indicators while providing interpretable explanations to support investment decisions. Furthermore, comparisons with multiple baseline approaches, including LLM-based re-ranking, neural rerankers, and time-series-based methods, demonstrate the utility of the proposed method. These results highlight the effectiveness of the proposed method as an explainable and practically deployable investment decision support system.}
}
