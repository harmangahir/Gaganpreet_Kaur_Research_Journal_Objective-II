@article{LU2025129431,
title = {Revisiting intelligent audit from a data science perspective},
journal = {Neurocomputing},
volume = {623},
pages = {129431},
year = {2025},
issn = {0925-2312},
doi = {https://doi.org/10.1016/j.neucom.2025.129431},
url = {https://www.sciencedirect.com/science/article/pii/S0925231225001031},
author = {Hongru Lu and Zhiang Wu},
keywords = {Data intelligence, Intelligent audit, Government auditing, Anomaly detection, Artificial intelligence},
abstract = {The contemporary auditing landscape faces challenges stemming from the proliferation of varied data and the intricacy of audit tasks. In response, auditors are progressively embracing data intelligence (DI) technologies to refine procedures and elevate audit quality, leading to the emergence of “intelligent audit”. Nevertheless, the prevailing focus of research on financial statement audits tends to overshadow the importance of broader contexts and the inherent complexity of audit tasks, particularly in government auditing. The research to date has primarily examined the impact of advanced technologies on auditing from technical and application perspectives, neglecting the essential steps and critical technological processes necessary for addressing audit challenges. Additionally, much of this discourse, including conclusions and proposed frameworks, lacks empirical and practical validation. This gap hinders engineers’ comprehension of intelligent auditing and impedes the development and implementation of effective intelligent audit systems. This paper provides a comprehensive review of intelligent auditing from the perspective of data science. Initially, we aim to formulate a formal definition of “intelligent audit”, a concept that currently lacks consensus in academia, and introduce three real-world case studies that highlight the diversity of data and the complexity of audit tasks. Subsequently, through bibliometric analysis, we provide an overview of the annual advancements and literature distribution pertinent to intelligent auditing. Furthermore, we investigate the paradigm shift and illustrative frameworks to shed light on the impacts of DI technologies. Additionally, we provide an in-depth summary of key technological applications in intelligent auditing, encompassing data modeling, anomaly detection, and advanced artificial intelligence techniques. The primary objective of this paper is to assist accountants and auditors in acquiring a profound comprehension of the current research landscape concerning the integration of novel technologies into auditing practices. Moreover, this survey seeks to attract the interest of computer scientists and artificial intelligence researchers in the auditing field, underscoring its potential as a promising area for application.}
}